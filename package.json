    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
