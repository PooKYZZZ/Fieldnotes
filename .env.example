# The app is only published on loopback by Compose. Change this only if port 3000 is occupied.
APP_PORT=3000

# Optional: existing Docker network shared with CyberTrace's cloudflared service.
# Set this only when using compose.cloudflare.yaml; find the name with `docker network ls`.
FIELDNOTES_TUNNEL_NETWORK=

# Local development authentication. Use OAuth credentials from a development-only Google/GitHub project.
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production-only values consumed by Compose; keep these different from local development.
FIELDNOTES_PROD_BETTER_AUTH_SECRET=
FIELDNOTES_PROD_GOOGLE_CLIENT_ID=
FIELDNOTES_PROD_GOOGLE_CLIENT_SECRET=
FIELDNOTES_PROD_GITHUB_CLIENT_ID=
FIELDNOTES_PROD_GITHUB_CLIENT_SECRET=
FIELDNOTES_PUBLIC_URL=https://learn.cybertracesystem.com
# Required verified owner identity for administration and safe adoption of legacy progress.
FIELDNOTES_OWNER_EMAIL=
